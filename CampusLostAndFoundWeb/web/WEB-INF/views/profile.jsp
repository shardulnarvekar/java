<% request.setAttribute("title", "My profile"); %>
<%@include file="header.jspf"%>
<div class="page-heading"><div><p class="eyebrow">YOUR CAMPUS ACCOUNT</p><h1>My profile</h1><p class="muted">Your account details and password settings.</p></div><span class="badge available"><%= WebSupport.html(currentUser.userType) %></span></div>
<div class="detail-layout"><section class="panel"><h2><%= WebSupport.html(currentUser.name) %></h2><dl class="details"><dt>Student ID / Username</dt><dd><%= WebSupport.html(currentUser.username) %></dd><dt>Location / Hostel</dt><dd><%= WebSupport.html(currentUser.location) %></dd><dt>Phone</dt><dd><%= WebSupport.html(currentUser.phone) %></dd><dt>Role</dt><dd><%= WebSupport.html(currentUser.userType) %></dd></dl></section>
<section class="panel"><h2>Change password</h2><form action="<%= context %>/ProfileServlet" method="post" class="stack"><input type="hidden" name="token" value="<%= formToken %>"><label>Current password<input type="password" name="oldPassword" maxlength="200" autocomplete="current-password" required></label><label>New password<input type="password" name="newPassword" maxlength="200" autocomplete="new-password" required></label><label>Confirm new password<input type="password" name="confirmPassword" maxlength="200" autocomplete="new-password" required></label><button class="button">Update password</button></form></section></div>
<%@include file="footer.jspf"%>
